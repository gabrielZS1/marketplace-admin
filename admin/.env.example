# Copie para .env (ignorado pelo git) para o "expo start" local.
# Nos builds (eas build), o valor vem do "env" de cada profile no eas.json.

# Backend que o app usa. Local: o IP da sua máquina. Staging: o Render.
EXPO_PUBLIC_API_URL=http://192.168.15.27:8082/api

# Relatório de falhas (Sentry). Opcional. Só funciona em builds de produção.
# Pegue o DSN no painel do Sentry (Project Settings > Client Keys) e coloque também
# no "env" do profile "production" do eas.json. O DSN não é secreto.
# EXPO_PUBLIC_SENTRY_DSN=https://xxxx@oNNNN.ingest.sentry.io/NNNN

# Teste local: religa a cobrança dentro do app (preço, "Assinar agora").
# NUNCA ligue isso nos builds das lojas.
# EXPO_PUBLIC_IN_APP_BILLING=true
