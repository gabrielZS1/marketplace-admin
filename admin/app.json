{
  "expo": {
    "name": "admin",
    "slug": "admin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/img/iconnot.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/img/iconnot.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/img/iconapp.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.gabrielzs1.admin",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/img/iconapp.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/sounds/notification-icon.png",
          "color": "#ffffff",
          "sounds": [
            "./assets/sounds/notific.mp3"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita o acesso às suas fotos para escolher a logo ou fotos do estabelecimento."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3c3e29a3-30ee-4a69-967c-10569a63597d"
      }
    }
  }
}
